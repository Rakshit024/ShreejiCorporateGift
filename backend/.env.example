# Copy this file to `.env` and adjust the values.
# `.env` is git-ignored. Never commit real secrets.

# HTTP port for the API
PORT=4000

# Comma-separated list of origins allowed to call this API.
# Admin dev server runs on 5174, storefront dev server on 5173.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# MongoDB connection string.
# Local: mongodb://127.0.0.1:27017/shreeji_gifts
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/shreeji_gifts?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/shreeji_gifts

# Secret used to sign admin JWTs. Generate a new one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Credentials for the first admin user created by `npm run seed`
ADMIN_NAME=Shreeji Admin
ADMIN_EMAIL=admin@shreeji.com
ADMIN_PASSWORD=Admin@12345

# Directory that uploaded images are written to (relative to this folder)
UPLOAD_DIR=uploads

# Max upload size per file, in megabytes
UPLOAD_MAX_MB=5